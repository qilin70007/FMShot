      "id": "web-eurocontrol",
      "name": "EUROCONTROL · 新闻",
      "kind": "web_list",
      "config": {
        "url": "https://www.eurocontrol.int/newsroom",
        "parseMode": "html",
        "itemSelector": ".node--news, .ec-c--newsroom-card",
        "linkSelector": "a[href^=\"/news/\"]",
        "titleSelector": ".field--promo-title",
        "publishedAtSelector": "time",
        "allowUrlPrefixes": [
          "https://www.eurocontrol.int/news/"
        ],
        "detail": {
          "maxFetches": 4,
          "publishedAtSelector": "meta[property=\"article:published_time\"], time",
          "titleSelector": "h1"
        },
        "_aihot": {
          "initialBackfillLimit": 4
        }
      },
      "tier": "T1",
      "owner_entity_id": "eurocontrol",
      "participation_mode": "editorial",
